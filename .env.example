# farmOS MCP configuration
# Copy to .env for local runs, or set these in your MCP client config.

# Base URL of the farmOS 3.x server (no trailing slash).
# A bare hostname or LAN IP also works: FARMOS_URL=192.168.3.140 -> http://192.168.3.140
FARMOS_URL=https://farm.example.com

# OAuth2 password grant. In farmOS 3.x the bundled default consumer client_id is "farm".
FARMOS_USERNAME=
FARMOS_PASSWORD=
FARMOS_CLIENT_ID=farm
# Optional: consumer secret / scope if your consumer requires them
# FARMOS_CLIENT_SECRET=
# FARMOS_SCOPE=

# Alternative to username/password: a pre-obtained bearer token (no refresh)
# FARMOS_ACCESS_TOKEN=

# Optional: path to a specific .env file (disables automatic .env discovery)
# FARMOS_MCP_ENV_FILE=/path/to/.env

# Safety: set to 1 to hide all write tools from agents (read-only mode)
# FARMOS_READ_ONLY=0

# Paging (farmOS/Drupal servers typically cap page[limit] at 50)
# FARMOS_DEFAULT_LIMIT=50
# FARMOS_MAX_LIMIT=50

# Max records farmos_summary will scan internally before reporting truncated=true
# FARMOS_SUMMARY_MAX_RECORDS=5000

# Per-request timeout in ms
# FARMOS_TIMEOUT_MS=30000
